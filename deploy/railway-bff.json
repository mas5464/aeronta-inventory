{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/bff.Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'uv run --no-sync uvicorn trax_io_spine.bff.asgi:app --host 0.0.0.0 --port ${PORT:-8000}'",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120
  }
}
